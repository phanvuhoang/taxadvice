# Database PostgreSQL (cùng database với văn bản thuế)
DATABASE_URL=postgresql://username:password@localhost:5432/taxadvice

# JWT Secret (tạo random string dài)
JWT_SECRET=your-random-secret-key-change-this

# AI Models
DEEPSEEK_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI (cho embedding)
OPENAI_API_KEY=sk-xxx

# Email SMTP (cho forgot password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Admin mặc định (tạo khi khởi động lần đầu)
ADMIN_EMAIL=admin@taxadvice.vn
ADMIN_PASSWORD=admin123

# Optional: Perplexity API (cho internet research)
PERPLEXITY_API_KEY=pplx-xxx

# Server
PORT=5000
NODE_ENV=production
